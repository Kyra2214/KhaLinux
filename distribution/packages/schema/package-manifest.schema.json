{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KhaLinux package manifest (schema 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "title", "description", "category", "architecture", "source", "verification", "validation"],
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]{0,63}$" },
    "version": { "type": "string", "pattern": "^[0-9][A-Za-z0-9.+~:_-]{0,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "category": { "enum": ["reconhecimento", "rede", "web", "forense", "auditoria", "sistema", "desenvolvimento", "outros"] },
    "architecture": { "enum": ["arm64", "all"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["debian-apt", "github-release", "khalinux-repository"] },
        "url": { "type": "string", "pattern": "^https://" },
        "apt_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+$" }
      }
    },
    "download_bytes": { "type": "integer", "minimum": 1 },
    "installed_bytes": { "type": "integer", "minimum": 1 },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "evidence": { "type": "string" }
      }
    },
    "validation": { "enum": ["verified", "unverified", "known-limited"] },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]{0,63}$" },
          "min_version": { "type": "string" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requires_network": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" } }
  }
}
