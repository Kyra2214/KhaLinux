    {
      "id": "android.adb.pair",
      "version": 1,
      "title": "Parear dispositivo Android por Wi-Fi",
      "domain": "DEVICE",
      "targetKind": "LOCAL_RUNTIME",
      "executor": "ADB",
      "description": "Executa adb pair usando o endpoint da porta de pareamento e o código temporário informado no aparelho.",
      "command": [
        "pair",
        "{{endpoint}}",
        "{{pairing_code}}"
      ],
      "requiredPackages": [
        "adb"
      ],
      "requiredCapabilities": [
        "adb.wireless.pairing"
      ],
      "parameters": [
        {
          "id": "endpoint",
          "type": "ADB_ENDPOINT",
          "required": true,
          "description": "IP/host e porta de pareamento exibidos em Wireless debugging."
        },
        {
          "id": "pairing_code",
          "type": "PAIRING_CODE",
          "required": true,
          "description": "Código temporário de seis dígitos exibido no aparelho."
        }
      ],
      "outputFields": [
        "stdout",
        "stderr",
        "exit_code",
        "duration_ms"
      ],
      "timeoutSeconds": 45,
      "enabled": true
    },
    {
