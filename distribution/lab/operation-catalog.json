      "id": "runtime.kernel-identity",
      "version": 1,
      "title": "Identidade do runtime Linux",
      "domain": "DEVICE",
      "targetKind": "LOCAL_RUNTIME",
      "executor": "ROOTFS_ARGV",
      "description": "Consulta a identificação do kernel exposta ao processo dentro do RootFS.",
      "command": [
        "uname",
        "-a"
      ],
      "requiredPackages": [
        "coreutils"
      ],
      "requiredCapabilities": [
        "rootfs.process.exec"
      ],
      "parameters": [],
      "outputFields": [
        "stdout",
        "stderr",
        "exit_code",
        "duration_ms"
      ],
      "timeoutSeconds": 10,
      "enabled": true
    },
